#!/usr/bin/env bash
# Blocks committing Config.xcconfig (personal signing identifiers, meant to stay
# gitignored — see CONTRIBUTING.md). Only fires if someone force-adds it; a plain
# `git add -A` can't stage a gitignored file in the first place.
set -euo pipefail

if git diff --cached --name-only | grep -qx "Config.xcconfig"; then
    echo "error: Config.xcconfig is staged for commit. It holds your personal Apple" >&2
    echo "Developer Team/bundle ID and must stay local — unstage it:" >&2
    echo "  git restore --staged Config.xcconfig" >&2
    echo "See CONTRIBUTING.md's \"Local signing setup\" section." >&2
    exit 1
fi

exit 0
