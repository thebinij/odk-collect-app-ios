# Xcode / XcodeGen generated project (regenerate with `xcodegen generate`)
*.xcodeproj/
*.xcworkspace/
DerivedData/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
.build/

# Build artifacts
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
/ODKCollect [0-9]*-[0-9]*-[0-9]*/

# Local secrets / service configs — never commit real API keys
GoogleService-Info.plist

# Local signing identifiers (bundle ID, Apple Developer Team) — copy
# Config.xcconfig.example to Config.xcconfig and fill in your own; never commit it
/Config.xcconfig
